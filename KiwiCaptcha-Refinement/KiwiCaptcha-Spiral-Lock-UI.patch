+.kiwi-widget {
+  --kiwi-state-rgb: var(--kiwi-primary-rgb);
+  --kiwi-state-color: var(--kiwi-primary);
+  --kiwi-state-text: var(--kiwi-badge-neutral-text);
+  display: flex;
+  align-items: flex-start;
+  gap: 12px;
+  width: 100%;
+  min-width: 0;
+  min-height: 92px;
+  padding: 14px;
+  border: 1px solid var(--kiwi-border);
+  border-radius: 16px;
+  background: var(--kiwi-bg);
+  color: var(--kiwi-text);
+  position: relative;
+  cursor: default;
+  transition: border-color 180ms ease;
+}
+.kiwi-widget[data-state="connecting"], .kiwi-widget[data-state="solving"] {
+  --kiwi-state-text: var(--kiwi-badge-solving-text);
+}
+.kiwi-widget[data-state="done"] {
+  --kiwi-state-rgb: var(--kiwi-success-rgb);
+  --kiwi-state-color: var(--kiwi-success);
+  --kiwi-state-text: var(--kiwi-badge-success-text);
+  border-color: rgba(var(--kiwi-success-rgb), 0.4);
+}
+.kiwi-widget[data-state="failed"], .kiwi-widget[data-state="expired"],
+.kiwi-widget[data-state="kiwi:worker-unavailable"],
+.kiwi-widget[data-state="kiwi:execution-unavailable"],
+.kiwi-widget[data-state="kiwi:solver-mismatch"] {
+  --kiwi-state-rgb: var(--kiwi-error-rgb);
+  --kiwi-state-color: var(--kiwi-error);
+  --kiwi-state-text: var(--kiwi-badge-error-text);
+  border-color: rgba(var(--kiwi-error-rgb), 0.4);
+}
+.kiwi-icon-wrapper {
+  flex: 0 0 36px;
+  width: 36px;
+  height: 36px;
+  display: grid;
+  place-items: center;
+  border: 1px solid rgba(var(--kiwi-state-rgb), 0.12);
+  border-radius: 11px;
+  background: rgba(var(--kiwi-state-rgb), 0.07);
+  color: var(--kiwi-state-color);
+}
+.kiwi-icon-wrapper svg { display: block; width: 24px; height: 24px; }
+.kiwi-main { flex: 1; min-width: 0; }
+.kiwi-top, .kiwi-bottom { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; }
+.kiwi-label {
+  flex: 1 1 auto;
+  min-width: 0;
+  font-size: calc(14px * var(--kiwi-font-scale));
+  font-weight: 600;
+  letter-spacing: -0.015em;
+  line-height: 1.45;
+  color: var(--kiwi-text);
+}
+.kiwi-badge {
+  flex: 0 1 auto;
+  min-width: 0;
+  max-width: 100%;
+  padding: 4px 8px;
+  border-radius: 6px;
+  font-family: var(--kiwi-mono);
+  font-size: calc(11px * var(--kiwi-font-scale));
+  font-weight: 600;
+  line-height: 1.4;
+  text-align: center;
+  background: var(--kiwi-track);
+  color: var(--kiwi-state-text);
+}
+.kiwi-widget[data-state="connecting"] .kiwi-badge,
+.kiwi-widget[data-state="solving"] .kiwi-badge,
+.kiwi-widget[data-state="done"] .kiwi-badge,
+.kiwi-widget[data-state="failed"] .kiwi-badge,
+.kiwi-widget[data-state="expired"] .kiwi-badge,
+.kiwi-widget[data-state="kiwi:worker-unavailable"] .kiwi-badge,
+.kiwi-widget[data-state="kiwi:execution-unavailable"] .kiwi-badge,
+.kiwi-widget[data-state="kiwi:solver-mismatch"] .kiwi-badge {
+  background: rgba(var(--kiwi-state-rgb), 0.1);
+}
+/* Older renderers may still include the decorative checksum strip. The
+   actual solver track is the single visible progress indicator. */
+.kiwi-slots { display: none; }
+.kiwi-track { margin-top: 9px; width: 100%; height: 2px; border-radius: 2px; background: var(--kiwi-track); overflow: hidden; }
+.kiwi-bar { width: 0%; height: 100%; border-radius: inherit; background: var(--kiwi-state-color); transition: width 250ms ease; }
+.kiwi-bar[data-progress="10"] { width: 10%; }
+.kiwi-bar[data-progress="20"] { width: 20%; }
+.kiwi-bar[data-progress="30"] { width: 30%; }
+.kiwi-bar[data-progress="40"] { width: 40%; }
+.kiwi-bar[data-progress="50"] { width: 50%; }
+.kiwi-bar[data-progress="60"] { width: 60%; }
+.kiwi-bar[data-progress="70"] { width: 70%; }
+.kiwi-bar[data-progress="80"] { width: 80%; }
+.kiwi-bar[data-progress="90"] { width: 90%; }
+.kiwi-bar[data-progress="100"] { width: 100%; }
+.kiwi-bottom { margin-top: 8px; }
+.kiwi-info {
+  flex: 1 1 auto;
+  min-width: 0;
+  margin: 0;
+  font-family: inherit;
+  font-size: calc(11.5px * var(--kiwi-font-scale));
+  line-height: 1.55;
+  color: var(--kiwi-text-muted);
+}
+.kiwi-timer {
+  flex: 0 1 auto;
+  min-width: 0;
+  max-width: 100%;
+  font-family: var(--kiwi-mono);
+  font-size: calc(10.5px * var(--kiwi-font-scale));
+  font-variant-numeric: tabular-nums;
+  line-height: 1.55;
+  color: var(--kiwi-text-muted);
+  direction: ltr;
+  unicode-bidi: isolate;
+}
+.kiwi-timer:empty { display: none; }
+.kiwi-retry {
+  display: none;
+  flex: 0 1 100%;
+  align-items: center;
+  justify-content: center;
+  width: 100%;
+  min-width: 44px;
+  min-height: 44px;
+  margin-top: 4px;
+  padding: 8px 12px;
+  border: 1px solid var(--kiwi-retry-border);
+  border-radius: 8px;
+  background: var(--kiwi-bg);
+  color: var(--kiwi-text);
+  font-family: inherit;
+  font-size: calc(12px * var(--kiwi-font-scale));
+  font-weight: 600;
+  line-height: 1.5;
+  cursor: pointer;
+}
+.kiwi-retry:hover { background: rgba(var(--kiwi-primary-rgb), 0.05); }
+.kiwi-retry:focus-visible { outline: 2px solid var(--kiwi-primary); outline-offset: 3px; }
+.kiwi-widget[data-state="idle"] .kiwi-retry,
+.kiwi-widget[data-state="failed"] .kiwi-retry,
+.kiwi-widget[data-state="expired"] .kiwi-retry,
+.kiwi-widget[data-state="kiwi:worker-unavailable"] .kiwi-retry,
+.kiwi-widget[data-state="kiwi:execution-unavailable"] .kiwi-retry { display: inline-flex; }
+/* Meaningful localized words always wrap, including at 200% text size.
+   No fixed text heights, clipping or ellipses, even in narrow host forms. */
+.kiwi-label, .kiwi-badge, .kiwi-info, .kiwi-timer, .kiwi-retry {
+  white-space: normal;
+  overflow: visible;
+  overflow-wrap: anywhere;
+  text-overflow: clip;
+}
+.kiwi-status { font-family: inherit; font-size: calc(11.5px * var(--kiwi-font-scale)); color: var(--kiwi-text-muted); margin-top: 8px; }
+.kiwi-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
+@media (prefers-reduced-motion: reduce) {
+  .kiwi-widget, .kiwi-badge, .kiwi-bar, .kiwi-slots i, .kiwi-icon-wrapper, .kiwi-retry { transition: none; animation: none; }
+}
+@media (forced-colors: active) {
+  .kiwi-widget, .kiwi-icon-wrapper, .kiwi-badge, .kiwi-track, .kiwi-retry { border: 1px solid CanvasText; }
+  .kiwi-bar { forced-color-adjust: none; background: Highlight; }
+  .kiwi-retry:focus-visible { outline-color: Highlight; }
+  .kiwi-widget[data-state="done"] { border-color: Highlight; }
+  .kiwi-widget[data-state="failed"], .kiwi-widget[data-state="expired"],
+  .kiwi-widget[data-state="kiwi:worker-unavailable"],
+  .kiwi-widget[data-state="kiwi:execution-unavailable"],
+  .kiwi-widget[data-state="kiwi:solver-mismatch"] { border-color: Mark; }
+  .kiwi-widget[data-state="solving"] { border-style: dashed; }
+}
