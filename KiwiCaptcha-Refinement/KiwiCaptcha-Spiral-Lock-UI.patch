+    document.querySelectorAll('[data-example]').forEach((el)=>el.appendChild(widget(el.dataset.example)));
+    document.querySelectorAll('.controls select').forEach((el)=>el.addEventListener('change',render));
+    document.querySelector('#theme').addEventListener('click',(event)=>{const dark=document.documentElement.dataset.theme!=='dark';document.documentElement.dataset.theme=dark?'dark':'light';event.currentTarget.setAttribute('aria-pressed',String(dark));event.currentTarget.textContent=dark?'Light theme':'Dark theme';});
