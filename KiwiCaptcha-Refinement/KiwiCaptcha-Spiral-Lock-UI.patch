+  <script>
+    const localeModule = window.__kiwiPreviewLocales;
+    delete window.__kiwiCaptchaCore;
+    delete window.__kiwiPreviewLocales;
+    const english = {
+      dir:'ltr', label:'Security Check', statusConnecting:'Connecting…', statusVerifying:'Verifying…', statusVerified:'Verification complete', statusFailed:'Verification failed', statusExpired:'Verification expired', statusWorkerUnavailable:'Check could not start', statusSolverMismatch:'Solver version mismatch',
+      badgeIdle:'Idle', badgeWait:'Wait', badgeWorking:'Working', badgeSuccess:'Success', badgeFailed:'Failed', badgeExpired:'Expired', badgeUnavailable:'Unavailable', badgeVersionError:'Version Error',
+      hintProtected:'Protected by KiwiCaptcha', hintVerified:'Proof-of-work verified locally.', hintClickRetry:'The connection failed. Press Retry to try again.', hintExpired:'The check expired. Press Retry to run it again.', hintWorker:'The security check could not start on this device. Press Retry to try again.', hintSolver:'The solver worker is out of date. Reload the page to load the current version.', retryButton:'Retry'
+    };
+    const states = {
+      pending:['label','badgeIdle','hintProtected'], connecting:['statusConnecting','badgeWait','hintProtected'], solving:['statusVerifying','badgeWorking','hintProtected'], done:['statusVerified','badgeSuccess','hintVerified'], failed:['statusFailed','badgeFailed','hintClickRetry'], expired:['statusExpired','badgeExpired','hintExpired'], 'kiwi:worker-unavailable':['statusWorkerUnavailable','badgeUnavailable','hintWorker'], 'kiwi:solver-mismatch':['statusSolverMismatch','badgeVersionError','hintSolver']
+    };
