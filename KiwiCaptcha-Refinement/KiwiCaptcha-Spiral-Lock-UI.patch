+    </section>
+    <section class="optics" aria-labelledby="optics-title"><div><h2 id="optics-title">One mark. Every size.</h2><p>A raised shackle and an open spiral. The same two strokes from favicon to wordmark.</p></div><div class="sizes"> <div class="size"><div class="mark" data-size="16" aria-hidden="true"></div><span>16 px</span></div><div class="size"><div class="mark" data-size="20" aria-hidden="true"></div><span>20 px</span></div><div class="size"><div class="mark" data-size="24" aria-hidden="true"></div><span>24 px</span></div><div class="size"><div class="mark" data-size="32" aria-hidden="true"></div><span>32 px</span></div><div class="size"><div class="mark" data-size="48" aria-hidden="true"></div><span>48 px</span></div><div class="size"><div class="mark" data-size="64" aria-hidden="true"></div><span>64 px</span></div></div></section>
