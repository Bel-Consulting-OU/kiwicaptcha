<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="captcha" method="upgrade">
    <name>plg_captcha_kiwicaptcha</name>
    <title>Plugin - KiwiCaptcha</title>
    <author>KiwiCaptcha contributors</author>
    <version>1.0.0</version>
    <description>PLG_CAPTCHA_KIWICAPTCHA_XML_DESCRIPTION</description>
    <files>
        <filename plugin="kiwicaptcha">kiwicaptcha.php</filename>
        <folder>src</folder>
        <folder>language</folder>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="verify_url" type="url" label="PLG_CAPTCHA_KIWICAPTCHA_VERIFY_URL"
                       default="http://127.0.0.1:7371/verify" filter="string"/>
                <field name="shim_url" type="url" label="PLG_CAPTCHA_KIWICAPTCHA_SHIM_URL"
                       default="" filter="string"/>
                <field name="bearer" type="password" label="PLG_CAPTCHA_KIWICAPTCHA_BEARER"
                       default="" filter="raw"/>
                <field name="mode" type="list" label="PLG_CAPTCHA_KIWICAPTCHA_MODE" default="json">
                    <option value="json">PLG_CAPTCHA_KIWICAPTCHA_MODE_JSON</option>
                    <option value="compat">PLG_CAPTCHA_KIWICAPTCHA_MODE_COMPAT</option>
                </field>
                <field name="scope" type="text" label="PLG_CAPTCHA_KIWICAPTCHA_SCOPE"
                       default="login" filter="string"/>
                <field name="trusted_proxies" type="text" label="PLG_CAPTCHA_KIWICAPTCHA_TRUSTED_PROXIES"
                       default="" filter="string"/>
            </fieldset>
        </fields>
    </config>
</extension>
