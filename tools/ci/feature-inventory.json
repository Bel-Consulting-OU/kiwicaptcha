    },
    {
      "path": "packages/kiwicaptcha-flutter/native",
      "capability": "the native FFI core (libkiwicaptcha_solver) the Flutter Dart bindings load over dart:ffi: real sha256/argon2id/rsw solving behind the exported C ABI of src/kiwicaptcha_solver.h, proven by tests/abi.rs which dlopens the built cdylib, solves the shared golden PHP vectors through the exported symbols, and verifies each solution with the workspace core verifier",
      "test": "cargo test (working-directory packages/kiwicaptcha-flutter/native)",
      "ci_job": "flutter",
      "markers": [
        "Cargo.toml",
        "tests"
      ],
      "kiwi_job": "flutter",
      "capabilities": [
        {
          "kind": "exports",
          "comment": "the C ABI exports one solver per algorithm, not a stub",
          "file": "src/lib.rs",
          "symbols": [
            "kiwi_solve_sha256",
            "kiwi_solve_rsw",
            "kiwi_solve_argon2id"
          ]
        },
        {
          "kind": "files",
          "comment": "the dlopen ABI test that exercises the exported symbols against the shared golden vectors",
          "files": [
            "tests/abi.rs"
          ]
        }
      ]
    }
