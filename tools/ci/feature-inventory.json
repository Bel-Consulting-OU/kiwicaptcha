      "path": "packages/kiwicaptcha-react-native",
      "test": "npm test",
      "ci_job": "web-wrappers",
      "markers": [
        "package.json",
        "test"
      ],
      "kiwi_job": "wrappers",
      "capabilities": [
        {
          "kind": "files",
          "comment": "both native solver modules and their iOS podspec exist",
          "files": [
            "android/src/main/java/**/KiwiCaptchaSolverModule.kt",
            "ios/KiwiCaptchaSolver.swift",
            "ios/KiwiCaptchaSolver.podspec"
          ]
        },
        {
          "kind": "dispatches",
          "comment": "the JS bridge dispatches to those native modules through both RN bridges, under the exact name they register",
          "file": "src/native.ts",
          "targets": [
            "TurboModuleRegistry",
            "NativeModules",
            "NATIVE_MODULE_NAME = \"KiwiCaptchaSolver\""
