  "protocols": {
    "risk_lua_dir": "protocol/risk-v1",
    "risk_lua_mirrors": [
      "packages/kiwicaptcha-risk/resources",
      "packages/kiwicaptcha-risk-php/resources"
    ],
    "minimum_count": 21,
    "corpora": [
      "protocol/decision-v1/corpus.json",
      "protocol/solution-token-v1/fixtures.json",
      "protocol/solution-token-v1/wire-hostile-corpus.json",
      "protocol/solution-token-v1/wire-signature-corpus.json",
      "protocol/limits.json",
      "protocol/execution-v1.json"
    ]
  },
  "manual_lanes": [
    {
      "name": "red-team battery",
      "command": "tools/redteam/exit-criteria.sh",
      "evidence": "THREATS.md"
    },
    {
      "name": "physical client performance",
      "command": "tools/client-perf/run-frozen.mjs",
      "evidence": "tools/client-perf/results/baseline.json"
    },
    {
      "name": "dogfood walk",
      "command": "tools/dogfood/dogfood.sh",
      "evidence": "tools/dogfood/README.md"
    }
  ]
