      "markers": [
        "Cargo.toml",
        "tests"
      ],
      "kiwi_job": "risk-rust",
      "capabilities": [
        {
          "kind": "files",
          "comment": "the escalation ladder is implemented, not just wired: the consistency-ledger ladder checker exists and the RSW adaptive-rung kernel has a dedicated Symfony test",
          "files": [
            "/tools/ci/consistency-ledger-ladder-check.py",
            "/packages/kiwicaptcha/integrations/symfony/tests/RswAdaptiveRungKernelTest.php"
          ]
        }
      ]
    },
    {
