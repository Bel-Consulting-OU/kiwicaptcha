{
  "schema": "kiwicaptcha.feature-inventory/1",
  "comment": "Every shipped surface and the lane that exercises it. The checker fails when a package, tool, protocol or platform integration exists on disk without an entry here, or when an entry names a lane that no workflow or runner invokes. A package may additionally declare a `capabilities` list: concrete, machine-checked facts about its implementation artifacts (an exported ABI symbol, a native module the JS bridge must dispatch to, a degradation marker that must stay gone). Capability paths are package-relative; a leading \"/\" anchors at the repository root for protocol-level markers that live outside the package.",
  "packages": [
    {
      "path": "packages/kiwicaptcha",
      "test": "cargo test --workspace",
      "ci_job": "rust",
      "markers": [
        "Cargo.toml",
        "tests"
      ],
      "kiwi_job": "rust"
    },
    {
      "path": "packages/kiwicaptcha-risk",
      "test": "cargo test -p kiwicaptcha-risk",
