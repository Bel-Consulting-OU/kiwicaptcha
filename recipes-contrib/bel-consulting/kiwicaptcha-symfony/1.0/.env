###> bel-consulting/kiwicaptcha-symfony ###
# Reference values for manual setups. The Flex recipe itself writes the
# generated secret and these defaults through manifest.json's "env" block;
# this file documents them for an application that installs the bundle by
# hand. Replace the secret with `openssl rand -hex 32` output.
KIWI_SECRET_KEY=
KIWI_REDIS_DSN=redis://127.0.0.1:6379/0
KIWI_PUBLIC_URL=https://captcha.example.com
