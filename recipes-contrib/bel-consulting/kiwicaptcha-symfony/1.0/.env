# KiwiCaptcha environment placeholders
#
# The recipe's manifest.json declares this value (Flex writes it into
# .env on install). If you apply the template manually, add it to your
# .env yourself.
KIWI_SECRET_KEY=change-me-to-a-random-32-byte-value

# The public origin and the Redis DSN are literals in
# config/packages/kiwicaptcha.yaml, not env placeholders: the bundle
# validates both shapes at container build time, before %env()%
# placeholders resolve. Replace them in the config file.
