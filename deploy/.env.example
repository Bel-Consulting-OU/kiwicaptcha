# Copy to deploy/.env and fill in. docker compose reads .env from the
# directory of the compose file automatically. deploy/.env is gitignored
# and must never be committed.

# REQUIRED. The challenge-signing secret: at least 32 bytes of random
# data. Generate with: openssl rand -hex 32
KIWI_SECRET_KEY=

# REQUIRED for docker compose. The Valkey requirepass credential of
# the bundled store service. Generate with: openssl rand -hex 16
VALKEY_PASSWORD=

# OPTIONAL. The ExecutionChallengeV1 keyed-PRF key (at least 32 bytes
# when set). When set, every issued challenge arms the browser-execution
# dimension; when unset, issuance stays execution-unarmed.
# KIWI_EXECUTION_KEY=

# OPTIONAL. The rsw time-lock trapdoor pair. Both values are required
# together; setting exactly one refuses startup. The pair arms the
# deployment for rsw: KIWI_ALGORITHM=rsw selects rsw as the issuance
# profile, and issuance is exclusively server-selected. A request
# `algorithm` field is validated metadata only and never selects the
# issued algorithm. The modulus is public; lambda is the secret
# trapdoor and must never leave the server configuration.
# KIWI_RSW_MODULUS_N=
# KIWI_RSW_LAMBDA=

# OPTIONAL knobs with documented defaults (see README.md).
# KIWI_ALGORITHM=sha256
# KIWI_SHA_TARGET_BITS=18
# KIWI_ARGON2_TARGET_BITS=4
# KIWI_ARGON2_M_KIB=65536
# KIWI_TTL_SECS=120
# KIWI_MIN_DURATION_MS=
# KIWI_RSW_T=75000
# Challenge requests per client IP per 60-second window (0 disables).
# KIWI_ISSUANCE_PER_MINUTE_PER_IP=30
# The /healthz round trip: full (write-probe-read-delete) or probe
# (PING only).
# KIWI_HEALTHZ_MODE=full
