# frozen_string_literal: true

source 'https://rubygems.org'

gemspec

group :stores do
  # The optional store backends. The core runs with none of these.
  gem 'sqlite3', require: false
  gem 'redis', require: false
end

group :argon2 do
  # The optional native Argon2id binding (libargon2 through FFI). The
  # verifier recomputes argon2id rungs through it when present and
  # refuses them loudly when it is not — never silently downgraded.
  gem 'argon2', require: false
end

group :integrations do
  # The optional web integrations under test.
  gem 'rack', require: false
  gem 'sinatra', require: false
end
