<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KiwiCaptcha\KiwiCaptcha.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The php-written sqlite interop fixture travels with the
         tests, so the interop assertions run from any checkout. -->
    <Content Include="testdata\php_interop.db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
