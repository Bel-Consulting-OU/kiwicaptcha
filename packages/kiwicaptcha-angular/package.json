{
  "name": "@kiwicaptcha/angular",
  "version": "0.1.0",
  "description": "Angular KiwiCaptcha widget: a standalone component (Ivy, signals) and an injectable driver service on the shared client core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "test": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "captcha",
    "kiwicaptcha",
    "angular",
    "pow",
    "widget"
  ],
  "peerDependencies": {
    "@angular/common": ">=17.3.0",
    "@angular/core": ">=17.3.0",
    "@kiwicaptcha/client-core": "^0.1.0",
    "rxjs": "^7.0.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@analogjs/vitest-angular": "^2.8.0",
    "@angular-devkit/build-angular": "^20.3.38",
    "@angular/cli": "^20.3.38",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.3.33",
    "@angular/compiler-cli": "^20.3.33",
    "@angular/core": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.3.33",
    "@kiwicaptcha/client-core": "file:../kiwicaptcha-client-core",
    "@types/jasmine": "^5.1.5",
    "jasmine": "^5.5.0",
    "jasmine-core": "^7.0.2",
    "jsdom": "^30.1.2",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "^5.1.0",
    "rxjs": "^7.8.1",
    "typescript": "~5.8.2",
    "vitest": "^5.0.3",
    "zone.js": "~0.15.0"
  }
}
