  "description": "Svelte 5 KiwiCaptcha widget: the KiwiCaptcha component and the kiwiCaptcha action on the shared client core.",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
