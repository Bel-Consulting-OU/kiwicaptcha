target/
pkg/
vendor/
composer.lock
# The deploy lock ships in the reference image (deploy/Dockerfile COPYs
# it and installs vendor exactly from it), so unlike development
# checkouts it is a tracked artifact, like the Cargo.lock files.
!deploy/app/composer.lock
.phpunit.result.cache
.phpunit.cache/
*.rs.bk
test-results/
playwright-report/
deploy/.env
tools/rsw-keygen/Cargo.lock

# Dogfood run output: runtime logs, never source.
tools/dogfood/last-run/*.log

# The interpreted languages' build and cache artifacts stay out of the
# index: python bytecode caches, the Elixir build tree, and the native
# sqlite3 NIF it compiles are reproducible from the tracked sources.
__pycache__/
*.pyc
_build/
sqlite3_nif.so
packages/kiwicaptcha-elixir/deps/
.DS_Store

# Generated per-run evidence: a fresh timestamp on every run.
tools/redteam/engine/runs/agent-loop-evidence.json
tools/redteam/engine/runs/agent-loop.err

# Red-team run documents are per-invocation evidence. CI artifacts,
# not source: each battery stamps a new timestamp and each code commit
# makes every older document STALE. A tagged release force-adds the
# one battery that ships with it (git add -f tools/redteam/engine/runs/<ts>-*).
tools/redteam/engine/runs/*.json
tools/redteam/engine/runs/*.log
# Cumulative engine state the gate reads, and the directory marker.
!tools/redteam/engine/runs/escalations.json
!tools/redteam/engine/runs/README.md

# Fuzz build and campaign logs are generated output, never source.
tools/redteam/fuzz/build.log
tools/redteam/fuzz/*.log
